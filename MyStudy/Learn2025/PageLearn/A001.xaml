<Page x:Class="Learn2025.PageLearn.A001"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Learn2025.PageLearn"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="A001">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Button x:Name="A001Array" Content="Array" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Array_Click"/>
                <Button x:Name="A001Abstract" Content="Abstract" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Abstract_Click"/>
                <Button x:Name="A001Async" Content="Async" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Async_Click"/>
                <TextBox x:Name="MyTextBox1" Width="137" TextWrapping="Wrap"></TextBox>
                <Button x:Name="A001Action" Content="Action" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Action_Click" />
                <Button x:Name="A001Action2" Content="Action2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Action2_Click" />
                <Button x:Name="A001Action3" Content="Action3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001Action3_Click" />
                <Button x:Name="A001As" Content="as" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="A001As_Click" />
            </StackPanel>
        </ScrollViewer>        
    </Grid>
</Page>
